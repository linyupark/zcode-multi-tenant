# 运行时数据（账号、会话、工作区、模型密钥、品牌配置）
data/
# 内核（官方构建产物，通过 scripts/update-kernel.mjs 获取）
kernel/
kernel.bak-*
.kernel-work/
# 本地配置
.env
# 依赖与日志
node_modules/
*.log
*.out
server.pid
# 设计工具产物
.taste-skill/
# 参考项目
ref/
# 前端构建产物（源码在 portal/frontend，部署时 npm run build 生成）
portal/static/
# 本仓库工作区的 zcode 会话/配置目录
.zcode/
# 手册生成管线工作目录（截图标注 + docx 产物）
.manual/
# 本地排查用的临时复现环境（租户 HOME 副本、测试脚本、SSE 抓包）
.repro/
