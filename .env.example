# zcode-multi-tenant 环境变量（复制为 .env 或直接 export）
PORT=9900
HOST=0.0.0.0
# 多实例/重启保持登录态请显式设置
# FLASK_SECRET=change-me
# 管理面板（设置后 admin 用户登录可见 /api/admin/users）
ADMIN_PASSWORD=
ADMIN_USER=admin
# 默认权限模式（未设置时服务端默认 yolo）：
#   yolo    全自动执行，可写入工作区（headless 推荐）
#   plan    只读规划，不改动文件
#   guarded 自动执行，但高危命令（rm -rf / git reset --hard / 强推等）会被拦截
# 注意：build / edit 需要人工审批通道，headless 派发下不可用，不要配置
ZCODE_MODE=yolo
# 内核覆盖（默认 kernel/zcode.cjs）
# ZCODE_CLI_ENTRY=/opt/ZCode/resources/glm/zcode.cjs
