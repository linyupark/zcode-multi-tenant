# zcode-multi-tenant 环境变量（复制为 .env 或直接 export）
PORT=9900
HOST=0.0.0.0
# 多实例/重启保持登录态请显式设置
# FLASK_SECRET=change-me
# 管理面板（设置后 admin 用户登录可见 /api/admin/users）
ADMIN_PASSWORD=
ADMIN_USER=admin
# 默认权限模式 plan|build|edit|guarded
ZCODE_MODE=plan
# 内核覆盖（默认 kernel/zcode.cjs）
# ZCODE_CLI_ENTRY=/opt/ZCode/resources/glm/zcode.cjs
